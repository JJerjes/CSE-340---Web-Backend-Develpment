<%- include('partials/header') %>

<main class="container">
  <h1><%= title %></h1>

  <h2>Dashboard</h2>
  <p>Name: <%= user.name %></p>
  <p>Username: <%= user.email %></p>

  <% if (locals.user && locals.user.role_name === 'admin') { %>
    <div class="admin-actions">
      <a href="/users" class="btn btn-primary">Manage Users</a>
    </div>
  <% } %>

  <hr>

  <section class="volunteered-projects-section" style="margin-top: 20px;">
    <h3>My Volunteered Projects</h3>

    <% if (volunteeredProjects && volunteeredProjects.length > 0) { %>
      <div class="projects-list">
        <% volunteeredProjects.forEach(project => { %>
          <div class="card mb-3 p-3" style="border: 1px solid #ddd; padding: 15px; margin-bottom: 15px; border-radius: 5px;">
            <h4>
              <a href="/project/<%= project.project_id %>"><%= project.title %></a>
            </h4>
            <p><strong>Organization:</strong> <%= project.organization_name || 'N/A' %></p>
            <p><strong>Location:</strong> <%= project.location %></p>
            <p><strong>Date:</strong> <%= new Date(project.project_date).toLocaleDateString() %></p>
            
            <!-- Botón para retirarse directamente desde el dashboard -->
            <form action="/project/<%= project.project_id %>/withdraw" method="POST" style="margin-top: 10px;">
              <button type="submit" class="btn btn-danger" style="background-color: #dc3545; color: white; padding: 6px 12px; border: none; border-radius: 4px; cursor: pointer;">Cancel Volunteering</button>
            </form>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <p>You haven't volunteered for any projects yet. <a href="/projects">Browse available projects</a> to sign up!</p>
    <% } %>
  </section>

</main>

<%- include('partials/footer') %>