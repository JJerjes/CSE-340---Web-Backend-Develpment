<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <h2>Upcoming Service Projects</h2>
  <ul>
    <% projects.forEach(project => { %>
      <li>
        <strong><%= new Date(project.date).toLocaleDateString('en-US', {month: 'short', day: 'numeric', year: 'numeric'}) %>:</strong> 
        <a href="/project/<%= project.project_id %>">
          <%= project.title %>
        </a> 
        (<%= project.organization_name %>)
      </li>
    <% }); %>    
  </ul>

  <% if (user && user.role_name === 'admin') { %>
    <a href="/new-project">Add New Project</a>
  <% } %>

</main>

<%- include('partials/footer') %>